build/
build-*/
compile_commands.json

# Screenshots dropped in the repo root by `mmo_client --shot`.
/*.png

# Raw CC0 asset packs (~120 MB, mostly-unused tiles). Restore with tools/fetch_assets.sh.
# The Ninja Adventure pack is downloaded manually — itch.io blocks scripted fetches.
# assets/atlas.png IS committed: it is the only art the build needs.
assets/_src/

# The account table the client writes beside itself. Contains Argon2 hashes, not passwords —
# but it is per-machine state, not source.
accounts.dat
# Per-machine connection preference (host/join + last address), like accounts.dat: state, not source.
client.cfg

# RFC-016: the whole saves/<world_name>/ directory is per-machine state (accounts.dat, progression
# and overlay durable logs, the world manifest) — the exportable save file a player moves around,
# never source. accounts.dat above now lives inside this tree by default.
/saves/

# Measurement scratch from tools/study_examples.py and tools/mock_world.py — contact sheets and
# derived JSON, all regenerable, none of it source.
tools/_study/

# Style-model scratch from tools/style_{corpus,wfc,synth}.py — the extracted corpus, the generated
# scenes and their previews. All regenerable from the pack's own Godot project, none of it source.
tools/_style/
tools/__pycache__/

# CTest output when ctest is run from the repo root rather than build/.
Testing/

# Agent worktrees are scratch checkouts, never content.
.claude/worktrees/
